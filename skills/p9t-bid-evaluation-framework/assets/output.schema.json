{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Skill Result",
  "type": "object",
  "required": [
    "status",
    "summary",
    "artifacts",
    "assumptions",
    "data_gaps",
    "risk_flags",
    "open_questions",
    "next_action",
    "confidence_level",
    "reasoning_trace",
    "escalation_required",
    "handoff_summary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    },
    "summary": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "data_gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Inputs or evidence that are missing and affect output reliability"
    },
    "risk_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Conditions that increase the chance of a wrong or misleading output"
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" },
    "confidence_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "INSUFFICIENT_DATA"],
      "description": "Qualitative confidence: HIGH = stakeholder-validated weights and specific anchors; MEDIUM = structurally sound, refinement needed; LOW = provisional weights, must not apply to live bids; INSUFFICIENT_DATA = decision criteria or requirements too thin to construct a defensible framework"
    },
    "reasoning_trace": {
      "type": "string",
      "description": "Brief narrative of how decision priorities were translated into dimensions, weights were allocated, and overlap was checked."
    },
    "escalation_required": {
      "type": "boolean",
      "description": "True when stakeholders disagree on weights, a mandatory criterion is absent, the framework produces only one defensible winner, or it was designed after bids were received."
    },
    "data": {
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "weight": { "type": "number" },
              "scoring_scale": { "type": "string" },
              "score_anchors": { "type": "object" },
              "evidence_expectation": { "type": "string" }
            }
          }
        },
        "total_weight": { "type": "number" },
        "commercial_weight": { "type": "number" },
        "overlap_check": {
          "type": "string",
          "enum": ["PASS", "FAIL"]
        },
        "mandatory_criteria": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "handoff_summary": {
      "type": "object",
      "description": "Distilled inputs for p9t-award-recommendation. Contains only what that skill needs — not the full output.",
      "properties": {
        "for_skill": { "type": "string" },
        "key_inputs": {
          "type": "object",
          "properties": {
            "scoring_model": { "type": "string" },
            "weights": { "type": "object" },
            "knockout_criteria": { "type": "array", "items": { "type": "string" } },
            "scores_per_supplier": { "type": "object" }
          }
        },
        "flags": { "type": "array", "items": { "type": "string" } },
        "assumptions_to_carry_forward": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["for_skill", "key_inputs"]
    }
  },
  "additionalProperties": true
}
