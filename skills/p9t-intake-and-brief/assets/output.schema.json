{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Skill Result",
  "type": "object",
  "required": [
    "status",
    "summary",
    "artifacts",
    "assumptions",
    "data_gaps",
    "risk_flags",
    "open_questions",
    "next_action",
    "confidence_level",
    "reasoning_trace",
    "escalation_required",
    "handoff_summary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    },
    "summary": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "data_gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Inputs or evidence that are missing and affect output reliability"
    },
    "risk_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Conditions that increase the chance of a wrong or misleading output"
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" },
    "confidence_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "Qualitative confidence: HIGH = objectives, scope, constraints, and stakeholders all confirmed; MEDIUM = some inferred; LOW = highly ambiguous"
    },
    "reasoning_trace": {
      "type": "string",
      "description": "Brief narrative of how the brief was structured from the inputs — what was stated, what was inferred, and what was left open."
    },
    "escalation_required": {
      "type": "boolean",
      "description": "True when contradictory objectives, missing stakeholders, or unrealistic timelines prevent a reliable brief."
    },
    "data": {
      "type": "object",
      "properties": {
        "brief_id": { "type": "string" },
        "category": { "type": "string" },
        "sourcing_objective": { "type": "string" },
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "must_have_requirements": { "type": "array", "items": { "type": "string" } },
        "nice_to_have_requirements": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "stakeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "approval_required": { "type": "boolean" }
            }
          }
        },
        "timeline": {
          "type": "object",
          "properties": {
            "target_award": { "type": "string" },
            "go_live": { "type": "string" }
          }
        },
        "incumbent_context": { "type": "string" },
        "budget_envelope": { "type": "string" }
      }
    },
    "handoff_summary": {
      "type": "object",
      "description": "Distilled inputs for p9t-supplier-longlist. Contains only what that skill needs — not the full output.",
      "properties": {
        "for_skill": { "type": "string" },
        "key_inputs": {
          "type": "object",
          "properties": {
            "category": { "type": "string" },
            "spec_summary": { "type": "string" },
            "geography": { "type": "string" },
            "spend_estimate": { "type": "string" },
            "timeline": { "type": "string" },
            "constraints": { "type": "array", "items": { "type": "string" } }
          }
        },
        "flags": { "type": "array", "items": { "type": "string" } },
        "assumptions_to_carry_forward": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["for_skill", "key_inputs"]
    }
  },
  "additionalProperties": true
}
