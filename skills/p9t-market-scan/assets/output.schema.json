{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Skill Result",
  "type": "object",
  "required": [
    "status",
    "summary",
    "artifacts",
    "assumptions",
    "data_gaps",
    "risk_flags",
    "open_questions",
    "next_action",
    "confidence_level",
    "reasoning_trace",
    "escalation_required",
    "source_quality",
    "data",
    "handoff_summary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    },
    "summary": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "data_gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Inputs or evidence that are missing and affect output reliability"
    },
    "risk_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Conditions that increase the chance of a wrong or misleading output"
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" },
    "confidence_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "INSUFFICIENT_DATA"],
      "description": "Qualitative confidence: HIGH = multiple independent sources; MEDIUM = partial evidence; LOW = significant inference required; INSUFFICIENT_DATA = cannot support actionable output."
    },
    "reasoning_trace": {
      "type": "string",
      "description": "Brief narrative linking inputs, sources, and conclusions for audit trail."
    },
    "escalation_required": {
      "type": "boolean",
      "description": "True when confidence is LOW or INSUFFICIENT_DATA, or critical risks need human adjudication."
    },
    "source_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recency", "coverage", "bias_risk"],
      "properties": {
        "recency": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"],
          "description": "How current the underpinning sources are relative to the decision window."
        },
        "coverage": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"],
          "description": "Breadth across suppliers, segments, and geographies sampled."
        },
        "bias_risk": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"],
          "description": "Risk that evidence is dominated by supplier claims or one-sided viewpoints."
        }
      },
      "description": "Structured appraisal of evidence quality for scan outputs."
    },
    "data": {
      "type": "object",
      "properties": {
        "market_structure": { "type": "string" },
        "concentration": { "type": "string" },
        "supplier_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "examples": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "cost_drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "driver": { "type": "string" },
              "trend": { "type": "string" },
              "buyer_influence": { "type": "string" }
            }
          }
        },
        "risk_signals": { "type": "array", "items": { "type": "string" } },
        "trends": { "type": "array", "items": { "type": "string" } }
      }
    },
    "handoff_summary": {
      "type": "object",
      "description": "Distilled inputs for p9t-supplier-longlist. Contains only what that skill needs — not the full output.",
      "properties": {
        "for_skill": { "type": "string" },
        "key_inputs": {
          "type": "object",
          "properties": {
            "verified_candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "country": { "type": "string" },
                  "products": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "market_flags": { "type": "array", "items": { "type": "string" } }
          }
        },
        "flags": { "type": "array", "items": { "type": "string" } },
        "assumptions_to_carry_forward": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["for_skill", "key_inputs"]
    }
  },
  "additionalProperties": true
}
