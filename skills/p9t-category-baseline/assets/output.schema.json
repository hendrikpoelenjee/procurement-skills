{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Skill Result",
  "type": "object",
  "required": [
    "status",
    "summary",
    "artifacts",
    "assumptions",
    "data_gaps",
    "risk_flags",
    "open_questions",
    "next_action",
    "confidence_level",
    "reasoning_trace",
    "escalation_required",
    "handoff_summary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    },
    "summary": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "data_gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Inputs or evidence that are missing and affect output reliability"
    },
    "risk_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Conditions that increase the chance of a wrong or misleading output"
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" },
    "confidence_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "Qualitative confidence: HIGH = data complete and consistent; MEDIUM = some gaps; LOW = significant gaps, indicative only"
    },
    "reasoning_trace": {
      "type": "string",
      "description": "Brief narrative of how spend data, supplier information, and cost driver analysis were synthesised into the baseline."
    },
    "escalation_required": {
      "type": "boolean",
      "description": "True when spend data is missing for a significant portion of the category, or supplier situation implies undisclosed dependency."
    },
    "source_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recency", "coverage", "bias_risk"],
      "properties": {
        "recency": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"],
          "description": "How current the spend and contract data are."
        },
        "coverage": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"],
          "description": "Completeness of spend coverage across the defined category scope."
        },
        "bias_risk": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"],
          "description": "Risk that baseline reflects a partial or stakeholder-filtered view of the category."
        }
      },
      "description": "Structured appraisal of evidence quality for baseline outputs."
    },
    "data": {
      "type": "object",
      "properties": {
        "category_scope": { "type": "string" },
        "spend_profile": {
          "type": "object",
          "properties": {
            "total_annual": { "type": "string" },
            "breakdown": { "type": "object" }
          }
        },
        "current_suppliers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "spend_share": { "type": "string" },
              "contract_status": { "type": "string" }
            }
          }
        },
        "cost_drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "driver": { "type": "string" },
              "type": { "type": "string" },
              "buyer_influence": { "type": "string" }
            }
          }
        },
        "sourcing_levers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lever": { "type": "string" },
              "estimated_value": { "type": "string" },
              "ease": { "type": "string" }
            }
          }
        },
        "contract_posture": { "type": "string" }
      }
    },
    "handoff_summary": {
      "type": "object",
      "description": "Distilled inputs for p9t-supplier-longlist. Contains only what that skill needs — not the full output.",
      "properties": {
        "for_skill": { "type": "string" },
        "key_inputs": {
          "type": "object",
          "properties": {
            "market_structure_summary": { "type": "string" },
            "price_benchmarks": { "type": "object" },
            "must_have_criteria": { "type": "array", "items": { "type": "string" } }
          }
        },
        "flags": { "type": "array", "items": { "type": "string" } },
        "assumptions_to_carry_forward": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["for_skill", "key_inputs"]
    }
  },
  "additionalProperties": true
}
